NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Cashfree Payment Gateway (Sandbox; server-side only)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_WEBHOOK_URL=https://your-domain.example/api/cashfree/webhook

# Trustit QR AI artwork (server-side only)
# Keep mock until the OpenAI API key is configured in the deployment environment.
TRUSTIT_AI_IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
