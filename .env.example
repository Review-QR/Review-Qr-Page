# ============================================
# TRUSTIT — Environment Configuration
# Copy this file to .env.local and fill in your values
# ============================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Cashfree Payment Gateway (Required) ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_WEBHOOK_URL=
CASHFREE_LIVE_PAYMENTS_ENABLED=false
CASHFREE_WEBHOOK_MAX_REPLAY_SECONDS=900

# --- App URL (Required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (Required for Google Sign-In) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS / OTP (Required) ---
FAST2SMS_API_KEY=

# --- AI Features (Optional) ---
TRUSTIT_AI_IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=

# --- Analytics (Recommended) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Error Tracking (Recommended) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Firebase / FCM Push Notifications (Required for push) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Cron Jobs (Required for scheduled tasks) ---
CRON_SECRET=

# --- Android Signing (Required for Play Store builds) ---
TRUSTIT_KEYSTORE_PATH=
TRUSTIT_STORE_PASSWORD=
TRUSTIT_KEY_ALIAS=
TRUSTIT_KEY_PASSWORD=

# --- Monitoring (Optional) ---
UPTIME_ROBOT_API_KEY=

# --- Email Service (Optional, if using Resend) ---
RESEND_API_KEY=
