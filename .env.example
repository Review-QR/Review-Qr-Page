NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Cashfree Payment Gateway (server-side only; never use NEXT_PUBLIC_ variables)
# Sandbox: use Sandbox credentials and these Sandbox values.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_WEBHOOK_URL=https://trustitreview.com/api/cashfree/webhook
# Keep false/unset until the Cashfree account has live PG approval and Live credentials.
CASHFREE_LIVE_PAYMENTS_ENABLED=false

# Production Vercel configuration after Cashfree Live approval:
# CASHFREE_CLIENT_ID=<Cashfree Live App ID>
# CASHFREE_CLIENT_SECRET=<Cashfree Live Secret Key>
# CASHFREE_ENVIRONMENT=production
# CASHFREE_API_BASE_URL=https://api.cashfree.com/pg
# CASHFREE_WEBHOOK_URL=https://trustitreview.com/api/cashfree/webhook
# CASHFREE_LIVE_PAYMENTS_ENABLED=true

# Trustit QR AI artwork (server-side only)
# Keep mock until the OpenAI API key is configured in the deployment environment.
TRUSTIT_AI_IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
