# Copy this file to android/keystore.properties (gitignored) for local signed release builds,
# or pass equivalent environment variables in CI/CD:
#   TRUSTIT_KEYSTORE_PATH=trustit-production.keystore
#   TRUSTIT_STORE_PASSWORD=<store-password>
#   TRUSTIT_KEY_ALIAS=trustit
#   TRUSTIT_KEY_PASSWORD=<key-password>

storeFile=trustit-production.keystore
storePassword=CHANGE_ME
keyAlias=trustit
keyPassword=CHANGE_ME
